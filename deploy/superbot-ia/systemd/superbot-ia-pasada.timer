[Unit]
Description=Superbot IA - pasadas programadas (misma cadencia que T-025: lun-vie 07:00, 08:30, 14:30, 21:00 Europe/London)

[Timer]
OnCalendar=Mon..Fri 07:00 Europe/London
OnCalendar=Mon..Fri 08:30 Europe/London
OnCalendar=Mon..Fri 14:30 Europe/London
OnCalendar=Mon..Fri 21:00 Europe/London
AccuracySec=1s
# Una pasada que llega tarde no es vinculante; nunca se recupera hacia atrás.
Persistent=false
Unit=superbot-ia-pasada.service

[Install]
WantedBy=timers.target

