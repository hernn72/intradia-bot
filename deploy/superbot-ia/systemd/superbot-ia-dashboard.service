[Unit]
Description=Superbot IA - dashboard paper visible (LAN, sin autenticación por decisión del propietario)
After=network-online.target

[Service]
User=fer
WorkingDirectory=/home/fer/superbot-ia-forward
EnvironmentFile=/home/fer/superbot-ia-forward/superbot-ia.env
# 192.168.1.113 (la propia LAN de la Pi), nunca 0.0.0.0: igual que superbot-dashboard.service
# (Superbot antiguo), solo escucha en la interfaz de la LAN, nunca en una posible interfaz
# expuesta a Internet. Sin SUPERBOT_IA_DASHBOARD_USUARIO/CLAVE en el .env, el dashboard se sirve
# sin autenticación (decisión explícita del propietario, 2026-11-08).
ExecStart=/home/fer/superbot-ia-venv/bin/python -m superbot.ia --db /home/fer/superbot-ia-forward/datos/superbot_ia.db dashboard --host 192.168.1.113 --port 8766
Restart=on-failure

[Install]
WantedBy=multi-user.target
