# Copia este archivo en la Pi como:
# /home/fer/superbot-ia-forward/superbot-ia.env
# El fichero real debe tener permisos 0600, vivir solo en la Pi y nunca
# commitearse ni copiarse de vuelta al repositorio.

# Bot propio y exclusivo de Superbot IA (el del Superbot antiguo tenía el
# token revocado cuando se intentó reutilizar, 2026-11-08).
SUPERBOT_IA_TELEGRAM_BOT_TOKEN=
SUPERBOT_IA_TELEGRAM_CHAT_ID=

# URL pública (en la LAN) del dashboard. Si se rellena, el comando /dashboard
# de Telegram responde con ella cuando se te olvide.
SUPERBOT_IA_DASHBOARD_URL=http://192.168.1.113:8766

# Credenciales del dashboard. Decisión del propietario (2026-11-08): se dejan
# EN BLANCO a propósito para acceso directo y sin contraseña desde cualquier
# dispositivo de la LAN doméstica (ver superbot-ia-dashboard.service, que
# además solo escucha en la IP de la LAN, nunca en 0.0.0.0). Rellenarlas
# vuelve a exigir usuario/clave (Basic Auth), igual que antes de esa decisión.
SUPERBOT_IA_DASHBOARD_USUARIO=
SUPERBOT_IA_DASHBOARD_CLAVE=

