# Copia este archivo a .env y rellena los valores. .env NO se sube a git.
#
# Las tres variables son OPCIONALES: sin ellas el informe se genera igual y
# se imprime por consola con los textos calculados a partir de los datos.

# Telegram. Si faltan, el informe solo se imprime por consola.
TELEGRAM_BOT_TOKEN=

# ID del chat/usuario/canal al que se enviarán los informes.
TELEGRAM_CHAT_ID=

# Anthropic. Habilita la capa narrativa del agente (ver ai.enabled en
# config.yaml). Sin ella, el informe usa los textos construidos con los
# datos calculados.
ANTHROPIC_API_KEY=

# EODHD, plan gratuito. Solo para el sondeo de OD-01 (D-39): comprobar si el
# JSON de fundamentales trae filing_date y el resto de campos antes de pagar
# nada. No lo usa el asesor.
EODHD_API_KEY=
